# Copy to .env.local to override the hosts the dev server (npm start) talks to / links to.
# Deployed containers ignore these; set the same names without the VITE_ prefix on the container.
VITE_API_URL=http://localhost:4000
VITE_MAIN_SITE=http://localhost:4200
# Links in the header (logo and app switcher); this app is LIBRARY_EDITOR_URL.
VITE_LIBRARIES_URL=http://localhost:4400
VITE_LIBRARY_EDITOR_URL=http://localhost:4300
VITE_DICTIONARY_URL=http://localhost:4500
